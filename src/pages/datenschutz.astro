---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import "../css/darkmode.css";
import "../css/fonts.css";
import "../css/fontawesome/css/fontawesome.css";
import "../css/fontawesome/css/all.min.css";
import Nav from "../components/Nav.astro";
import { datenschutz, LEGAL_STAND } from "../data/legal.js";
---

<BaseLayout title="Datenschutzerklärung | Colin Blome">
  <Nav />
  <main class="datenschutz-container">
    <div class="container">
      <div class="header-container">
        <a href={import.meta.env.BASE_URL} class="back-button">
          <i class="fas fa-arrow-left"></i>
          <span>Zurück</span>
        </a>
        <h1>Datenschutzerklärung</h1>
      </div>

      <p class="privacy-meta">Stand: {LEGAL_STAND}</p>

      {datenschutz.map((s) => (
        <section>
          <h2>{s.title}</h2>
          {s.blocks.map((b) =>
            b.h3 ? <h3>{b.h3}</h3>
            : b.ul ? <ul>{b.ul.map((li) => <li set:html={li} />)}</ul>
            : <p set:html={b.p} />
          )}
        </section>
      ))}

    </div>
  </main>

  <!-- Fixierter Theme Toggle Button -->
  <button
    id="darkModeToggle"
    class="theme-toggle fixed z-50 p-3 rounded-full shadow-lg focus:outline-hidden"
    aria-label="Theme wechseln"
  >
    <!-- Icon wird per JavaScript eingefügt -->
  </button>
  <Footer />
</BaseLayout>

<style>
  .datenschutz-container {
    margin: 0 auto;
    padding: 18rem 2rem 18rem 2rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    background-color: var(--bg-primary);
  }
  .container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    background-color: var(--bg-secondary);
    color: var(--text-titel);
    box-shadow: var(--card-shadow);
    border-radius: 10px;
    position: relative;
    z-index: 1;
  }
  .header-container {
    display: flex;
    align-items: center;
    margin-bottom: 2rem;
    gap: 1rem;
  }
  .back-button {
    display: flex;
    align-items: center;
    padding: 0.6rem 1.2rem;
    background-color: var(--bg-secondary);
    color: var(--text-titel);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-weight: 500;
    box-shadow: var(--card-shadow);
  }
  .back-button:hover {
    transform: translateY(-3px);
    background-color: var(--accent);
  }
  .back-button i {
    margin-right: 8px;
    font-size: 0.9rem;
  }
  h1 {
    color: var(--accent);
    font-size: 2rem;
    font-weight: bold;
    margin: 0;
    flex-grow: 1;
    text-align: center;
  }
  h2 {
    color: var(--text-titel);
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    font-weight: 600;
  }
  h3 {
    color: var(--text-titel);
    font-size: 1.2rem;
    margin: 1.5rem 0 0.75rem;
    font-weight: 600;
  }
  p {
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .privacy-meta {
    color: var(--text-primary);
    opacity: 0.7;
    text-align: center;
    margin: -1rem 0 2.5rem;
  }
  section :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  section ul {
    margin: 0.75rem 0 1rem 1.25rem;
  }
  section li {
    line-height: 1.6;
    margin-bottom: 0.35rem;
  }
  section :global(code) {
    color: var(--accent);
  }
  section {
    margin-bottom: 2rem;
  }
  @media (max-width: 768px) {
    .datenschutz-container {
      padding: 5rem 1rem 6rem 1rem;
    }
    .container {
      padding: 1.5rem;
    }
    h1 {
      margin-top: 0.5rem;
      font-size: 1.75rem;
    }
    h2 {
      font-size: 1.25rem;
    }
    h3 {
      font-size: 1.1rem;
    }
    .header-container {
      flex-direction: column;
      align-items: center;
      margin-bottom: 1.5rem;
      gap: 1rem;
    }
    .back-button {
      margin-bottom: 0.5rem;
      align-self: center;
      width: 120px;
      justify-content: center;
    }
  }
  .theme-toggle {
    bottom: 20px;
    right: 20px;
    padding: .9rem;
    width: 55px;
    background-color: var(--bg-secondary);
    border: 1px currentColor var(--border);
    color: var(--accent);
    transition: all 0.3s ease;
  }
  .theme-toggle:hover {
    box-shadow: 0 0 10px 2px var(--pulse-shadow-mid);    
    color: var(--accent);
    background-color: var(--bg-secondary);
  }
  .theme-toggle i {
    font-size: 1.5rem;
    transition: transform 0.5s;
  }
  .theme-toggle:hover i {
    transform: scale(1.2);
  }
</style>

<script>
  // Dark Mode Logic - wie auf der Impressum-Seite
  document.addEventListener("DOMContentLoaded", () => {
    const darkModeToggle = document.getElementById("darkModeToggle");
    const prefersDarkScheme = window.matchMedia("(prefers-color-scheme: dark)");
    // Check for saved theme preference or use the system preference
    const savedTheme = localStorage.getItem("theme");
    if (savedTheme === "dark" || (!savedTheme && prefersDarkScheme.matches)) {
      document.documentElement.classList.add("dark-mode");
      updateIcon(true);
    } else {
      document.documentElement.classList.remove("dark-mode");
      updateIcon(false);
    }
    // Toggle dark mode on click
    darkModeToggle.addEventListener("click", () => {
      const isDarkMode = document.documentElement.classList.toggle("dark-mode");
      localStorage.setItem("theme", isDarkMode ? "dark" : "light");
      updateIcon(isDarkMode);
    });
    // Update the icon
    function updateIcon(isDarkMode) {
      darkModeToggle.innerHTML = '';
      const icon = document.createElement('i');
      if (isDarkMode) {
        icon.className = 'fa-solid fa-sun';
        icon.setAttribute('title', 'Light Mode aktivieren');
      } else {
        icon.className = 'fa-solid fa-moon';
        icon.setAttribute('title', 'Dark Mode aktivieren');
      }
      darkModeToggle.appendChild(icon);
    }
  });
</script>
