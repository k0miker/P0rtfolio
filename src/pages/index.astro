---
import "../css/tailwind.css";
import "../css/styles.css";
import "../css/fonts.css";
import "../css/keyframes.css";
import "../css/darkmode.css";
import "../css/terminal.css";
import "../css/fontawesome/css/fontawesome.css";
import "../css/fontawesome/css/all.min.css";
import Nav from "../components/Nav.astro";
import Iam from "../components/Iam.astro";
import Myself from "../components/Myself.astro";
import Projects from "../components/Projects.astro";
import OtherVersions from "../components/OtherVersions.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import ScrollProgress from "../components/ui/ScrollProgress.astro";
import CookieConsent from "../components/CookieConsent.astro";
import Versiontoggle from "../components/Versiontoggle.astro";
import Region from "../components/Region.astro";
import { SITE_URL, homeGraph } from "../data/seo.js";

const title = "Webdesign & Webentwicklung in Fürstenau | Colin Blome";
const description =
  "Websites für Unternehmen in Fürstenau, Bersenbrück und Umgebung: schnell, mobil, gut bei Google auffindbar. Persönliche Beratung vor Ort – jetzt anfragen.";

// Prüfen, ob Cookie-Consent bereits gesetzt wurde
const hasCookieConsent = false; // Dies wird clientseitig überprüft
---

<html class="w-full" lang="de">
  <head>
    <!-- Sofort ausgeführtes Script für Scroll-Blockierung -->
    <script is:inline>
      // Cookie-Consent wird komplett von der CookieConsent-Komponente verwaltet
      // Kein dupliziertes Scroll-Blocking hier
    </script>

    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE_URL}/og-image-wide.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Webdesign und Webentwicklung in Fürstenau – CB-Webdevelopment, Colin Blome" />
    <meta property="og:url" content={`${SITE_URL}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CB-Webdevelopment" />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/og-image-wide.png`} />

    <link rel="canonical" href={`${SITE_URL}/`} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Colin Blome" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

    <!-- Lokale Zuordnung -->
    <meta name="geo.region" content="DE-NI" />
    <meta name="geo.placename" content="Fürstenau" />
    <meta name="geo.position" content="52.5167;7.6667" />
    <meta name="ICBM" content="52.5167, 7.6667" />

    <!-- Strukturierte Daten: WebSite, Person, ProfessionalService, FAQPage.
         Quelle: src/data/seo.js – alles davon ist auch sichtbar auf der Seite. -->
    <script type="application/ld+json" set:html={JSON.stringify(homeGraph())} />
  </head>
  <body
    class="w-full flex-col items-center content-center fadein2 custom-scrollbar"
  >
    <!-- Seitenüberschrift: visuell trägt das Hero-Typing, für Screenreader/Gliederung dieses h1 -->
    <h1 class="sr-only">Colin Blome – Webentwicklung aus Fürstenau</h1>

    <div id="home"></div>
    <Nav />
    <ScrollProgress />

    <Iam />

    <div id="about">
      <Myself />
    </div>

    <Skills />

    <div id="projects">
      <Projects />
    </div>
    <OtherVersions />

    <!-- Erst überzeugen (Leistungen, Region, FAQ), dann Kontakt -->
    <Region />

    <div id="contact">
      <Contact />
    </div>

    <Footer />

    <button
      id="darkModeToggle"
      class="theme-toggle fixed z-50 p-3 rounded-full shadow-lg focus:outline-hidden"
      aria-label="Theme wechseln"
    >
    </button>

    <Versiontoggle active={1} />

    <button
      id="performanceToggle"
      class="performance-toggle fixed z-50 p-3 rounded-full shadow-lg focus:outline-hidden"
      aria-label="Performance-Modus wechseln"
      title="Performance-Modus wechseln"
    >
    </button>

    <!-- Cookie-Consent-Banner mit Overlay -->
    <CookieConsent />

    <!-- Script zum Verhindern des Scrollens während das Cookie-Banner angezeigt wird -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        // Cookie-Consent wird vollständig von der CookieConsent-Komponente verwaltet
        // Kein redundanter Code hier
      });
    </script>

    <!-- Import Main Script -->
    <script src="../scripts/main.js"></script>
</body>
</html>

<style>
  /* Global base font-size — scales up for wide screens */
  html {
    font-size: 85%;
  }
  @media (min-width: 2000px) {
    html { font-size: 93%; }
  }
  @media (min-width: 2560px) {
    html { font-size: 100%; }
  }
  @media (min-width: 3200px) {
    html { font-size: 107%; }
  }

  * {
    padding: 0;
    margin: 0;
  }

  /* Editorial-Basis: Body in Sans (Inter), Mono nur noch als gezielter Akzent
     (Headlines-Suffixe, Labels, Cursor — via .font-[mono] / font-family: mono). */
  html {
    font-family: var(--font-mono);
    /* Sicherheitsnetz gegen horizontales Panning auf Mobile:
       clip statt hidden, damit kein Scroll-Container entsteht */
    overflow-x: clip;
  }
  body {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  @media (prefers-reduced-motion: no-preference) {
    * {
      scroll-behavior: smooth;
    }
  }

  /* Styles nur anwenden, wenn keine Scroll-Blockierung aktiv ist */
  html:not(.no-scroll) body {
    overflow-x: hidden;
    background-color: var(--bg-primary);
    color: var(--text-primary);
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  #about {
    position: relative;
    min-height: 100vh;
    z-index: 0;
    padding-bottom: 70px;
  }

  @media (min-width: 1280px) {
    #about {
      min-height: unset;
    }
  }
  #skills {
    min-height: 100vh;
  }
  #projects {
    position: relative;
    padding: 0px 0;
    background-size: 500%;
    background-repeat: no-repeat;
    background-attachment: fixed;
    background-position: center;
    z-index: 0;
  }
  #contact {
    padding-top: 50px;
  }
  .blurred {
    filter: blur(5px);
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: tomato;
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background-color: #00000000;
  }

  .theme-toggle {
    bottom: 50px;
    right: 20px;
    padding: 0;
    width: 55px;
    height: 55px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-secondary);
    color: var(--accent);
    transition: all 0.3s ease;
  }

  .theme-toggle:hover {
    box-shadow: 0 0 10px 2px var(--pulse-shadow-mid);
    color: var(--accent);
    background-color: var(--bg-secondary);
  }
  .theme-toggle:hover i {
    transform: scale(1.5);
    transition: 0.5s;
  }

  .theme-toggle i {
    font-size: 1.5rem;
  }

  .performance-toggle {
    bottom: 50px;
    left: 20px;
    padding: 0;
    width: 55px;
    height: 55px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-secondary);
    color: var(--accent);
    transition: all 0.3s ease;
  }
  @media (max-width: 768px) {
    .theme-toggle {
      bottom: 55px;
      right: 15px;
      padding: 0;
      width: 45px;
      height: 45px;
    }

    .theme-toggle i {
      font-size: 1.2rem;
    }

    .performance-toggle {
      bottom: 55px;
      left: 15px;
      padding: 0;
      width: 45px;
      height: 45px;
    }
    .performance-toggle i {
      font-size: 1.2rem;
    }
  }

  .performance-toggle i {
    font-size: 1.5rem;
    color: var(--accent);
    transition: transform 0.5s ease;
  }

  .performance-toggle:hover {
    box-shadow: 0 0 10px 2px var(--pulse-shadow-mid);
  }

  .performance-toggle:hover i {
    transform: scale(1.5);
  }

</style>
