---
import logo from "../assets/images/logo.webp";
import { projects } from "../data/projectData.js";
import { navSections } from "../data/navSections.js";

// Home übernimmt das Logo, Contact ist der CTA rechts außen
const byId = Object.fromEntries(navSections.map((s) => [s.id, s]));
const links = [byId.about, byId.skills];
const afterProjects = [byId.region];
const contact = byId.contact;
---

<!-- Hauptnavigation -->
<header class="head" id="navbar">
  <div id="nav-container">
    <!-- Logo + Hamburger -->
    <div class="name flex flex-row items-center w-full justify-between">
      <a
        href="/"
        aria-label="CB-WebDev – Startseite"
        class="name lg:text-lg font-semibold duration-200 flex items-center justify-center font-[mono] hover:tracking-[5px] md:hover:tracking-[10px] uppercase rounded-lg focus:outline-hidden"
        ><img class="logo" src={logo.src} alt="" /><i>C</i><span>olin</span>
        <i>B</i><span>lome </span><span class="dev">
          Webdev<i class="dash animate-ping">_</i></span
        ><span>elopment</span><span class="animate-ping">_</span></a
      >

      <button
        class="mobile-menu-button"
        id="mobile-menu-btn"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="main-nav"
      >
        <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>

    <nav id="main-nav" class="mobile-menu" aria-label="Hauptnavigation">
      <ul class="nav-links">
        {
          links.map((s) => (
            <li>
              <a class="nav-link" href={s.href} data-section={s.id}>
                /{s.label}
              </a>
            </li>
          ))
        }

        <!-- Projekte: Mega-Panel (Desktop) bzw. einfacher Link (Mobile) -->
        <li class="nav-projects" id="nav-projects-item">
          <button
            class="nav-link nav-projects-trigger"
            id="nav-projects"
            data-section="projects"
            aria-expanded="false"
            aria-controls="projects-panel"
          >
            /{byId.projects.label}
            <svg class="chevron" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M5.5 7.5 10 12l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <a class="nav-link nav-projects-mobile" href={byId.projects.href} data-section="projects">
            /{byId.projects.label}
          </a>

          <div class="projects-panel" id="projects-panel">
            <div class="panel-card">
              <div class="panel-head">
                <span class="panel-kicker">~/projects <span class="panel-count">{projects.length}</span></span>
                <a class="panel-all" href={byId.projects.href}>
                  Alle Projekte mit Details <span aria-hidden="true">→</span>
                </a>
              </div>
              <ul class="panel-grid">
                {
                  projects.map((p) => (
                    <li>
                      <a class="panel-item" href={p.website} target="_blank" rel="noopener noreferrer">
                        <img src={p.image} alt="" width="64" height="40" loading="lazy" decoding="async" />
                        <span class="panel-text">
                          <span class="panel-title">{p.title}</span>
                          {p.category && <span class="panel-cat">{p.category}</span>}
                        </span>
                        <svg class="panel-ext" viewBox="0 0 20 20" aria-hidden="true">
                          <path d="M8 5h7v7M15 5l-9 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span class="sr-only">(öffnet in neuem Tab)</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </li>

        {
          afterProjects.map((s) => (
            <li>
              <a class="nav-link" href={s.href} data-section={s.id}>
                /{s.label}
              </a>
            </li>
          ))
        }

        <li class="nav-cta-item">
          <a class="nav-cta" href={contact.href} data-section={contact.id}>
            /{contact.label}
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="nav-progress" aria-hidden="true"></div>
</header>

<style>
  /* ---------- Header ---------- */
  .head {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: clamp(64px, 10vh, 110px);
    color: #e8e8e8;
    background: var(--nav-bg);
    box-shadow: var(--nav-shadow);
    transition:
      height 0.4s ease,
      background-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  .head.colored {
    height: clamp(56px, 7vh, 80px);
    color: var(--text-secondary);
    background: color-mix(in srgb, var(--bg-primary) 88%, transparent);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    /* Akzentlinie unten – gleiche Linie wie oben am Footer; dient mobil als Spur der Fortschrittslinie */
    box-shadow:
      inset 0 -1px 0 color-mix(in srgb, var(--accent) 65%, transparent),
      var(--nav-shadow-solid);
  }

  #nav-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 100%;
    max-width: 2800px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  /* Scroll-Fortschritt als Linie unter dem Header (nur ohne Seitenleiste) */
  .nav-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(var(--scroll-progress, 0));
    transform-origin: left;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .head.colored .nav-progress {
    opacity: 1;
  }
  @media (min-width: 1100px) {
    .nav-progress {
      display: none;
    }
  }

  /* ---------- Desktop-Links ---------- */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    height: 100%;
    list-style: none;
  }

  .nav-links > li {
    display: flex;
    align-items: center;
    height: 100%;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.75rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  /* Aktiv-Markierung: kurzer Strich unter dem Link */
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .nav-link:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }
  .head.colored .nav-link:hover {
    color: var(--text-primary);
    background: color-mix(in srgb, var(--text-primary) 7%, transparent);
  }

  .nav-link[aria-current="true"] {
    color: var(--accent);
  }
  .nav-link[aria-current="true"]::after {
    transform: scaleX(1);
  }

  .nav-link:focus-visible,
  .nav-cta:focus-visible,
  .panel-item:focus-visible,
  .panel-all:focus-visible,
  .mobile-menu-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .chevron {
    width: 1rem;
    height: 1rem;
    transition: transform 0.25s ease;
  }
  .nav-projects[data-open] .chevron {
    transform: rotate(180deg);
  }
  .nav-projects-trigger::after {
    right: 1.95rem;
  }

  .nav-projects-mobile {
    display: none;
  }

  /* CTA */
  .nav-cta-item {
    margin-left: 0.75rem;
  }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.1rem;
    border: 1.5px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  /* Über dem Hero-Bild: helle Schrift für Kontrast */
  .head:not(.colored) .nav-cta {
    color: #fff;
    background: color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .nav-cta:hover,
  .head .nav-cta[aria-current="true"],
  .head:not(.colored) .nav-cta:hover {
    background: var(--accent);
    color: #fff;
  }

  /* ---------- Projekte-Panel ---------- */
  /* Hängt am Header-Container (nicht am Link), damit es bündig unter der Leiste sitzt.
     Das <li> ist so hoch wie der Header → keine Hover-Lücke zum Panel. */
  .projects-panel {
    position: absolute;
    top: 100%;
    right: 1.5rem;
    width: min(780px, calc(100vw - 3rem));
    padding-top: 0.5rem;
    display: none;
    opacity: 0;
    translate: 0 -6px;
    transition:
      opacity 0.18s ease,
      translate 0.18s ease,
      display 0.18s allow-discrete;
  }

  .nav-projects[data-open] .projects-panel {
    display: block;
    opacity: 1;
    translate: 0 0;
  }

  @starting-style {
    .nav-projects[data-open] .projects-panel {
      opacity: 0;
      translate: 0 -6px;
    }
  }

  .panel-card {
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-card);
    color: var(--text-primary);
    box-shadow: var(--card-elev, 0 20px 40px rgba(0, 0, 0, 0.25));
    overscroll-behavior: contain;
  }

  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.25rem 0.5rem 0.75rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .panel-kicker {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .panel-count {
    margin-left: 0.25rem;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    color: var(--accent);
    font-weight: 700;
  }

  .panel-all {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    border-radius: 6px;
  }
  .panel-all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .panel-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem;
    list-style: none;
  }
  @media (min-width: 1280px) {
    .panel-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .projects-panel {
      width: min(980px, calc(100vw - 3rem));
    }
  }

  .panel-item {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 1rem;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem;
    border-radius: 10px;
    color: var(--text-primary);
    transition: background-color 0.15s ease;
  }
  .panel-item:hover {
    background: color-mix(in srgb, var(--accent) 9%, transparent);
  }

  .panel-item img {
    width: 64px;
    height: 40px;
    object-fit: cover;
    border-radius: 6px;
    background: var(--bg-tertiary);
  }

  .panel-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .panel-title {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .panel-cat {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .panel-ext {
    width: 1rem;
    height: 1rem;
    color: var(--accent);
    opacity: 0;
    translate: -3px 3px;
    transition:
      opacity 0.15s ease,
      translate 0.15s ease;
  }
  .panel-item:hover .panel-ext,
  .panel-item:focus-visible .panel-ext {
    opacity: 1;
    translate: 0 0;
  }

  /* ---------- Hamburger ---------- */
  .mobile-menu-button {
    display: none;
    position: relative;
    z-index: 101;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .head.colored .mobile-menu-button {
    color: var(--text-primary);
  }

  .burger {
    position: relative;
    display: block;
    width: 24px;
    height: 16px;
    margin: auto;
  }
  .burger span {
    position: absolute;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.25s ease,
      opacity 0.2s ease,
      width 0.25s ease;
  }
  .burger span:nth-child(1) {
    top: 0;
    width: 100%;
  }
  .burger span:nth-child(2) {
    top: 7px;
    width: 100%;
  }
  .burger span:nth-child(3) {
    top: 14px;
    width: 60%;
    left: 40%;
  }
  .head.menu-open .burger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .head.menu-open .burger span:nth-child(2) {
    opacity: 0;
  }
  .head.menu-open .burger span:nth-child(3) {
    left: 0;
    width: 100%;
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ---------- Mobile: Fullscreen-Overlay im Terminal-Look ---------- */
  @media (max-width: 899px) {
    #nav-container {
      padding-inline: 0.75rem;
    }

    .mobile-menu-button {
      display: block;
    }

    /* Bei offenem Menü über Floating-Buttons (Versiontoggle z-9990) heben */
    .head.menu-open {
      z-index: 9995;
    }
    .head.menu-open .mobile-menu-button {
      color: var(--text-primary);
    }

    #nav-container > .name {
      position: relative;
      z-index: 101;
    }

    nav.mobile-menu {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: 100dvh;
      padding: 70px 0 2.5rem;
      overflow-y: auto;
      background: var(--bg-primary);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition:
        opacity 0.25s ease,
        transform 0.25s ease,
        visibility 0s linear 0.25s;
    }

    nav.mobile-menu.open {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 0.25s ease,
        transform 0.25s ease;
    }

    .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 0.35rem;
      width: min(78vw, 320px);
      height: auto;
      margin-inline: auto;
    }

    .nav-links > li {
      display: block;
      height: auto;
    }

    .nav-link {
      display: flex;
      width: 100%;
      padding: 0.9rem 0.75rem;
      font-size: 1.1rem;
      color: var(--text-primary);
    }
    .nav-link::before {
      content: ">";
      color: var(--accent);
      margin-right: 0.5rem;
    }
    .nav-link::after {
      display: none;
    }
    .nav-link:active,
    .nav-link:hover,
    .head.colored .nav-link:hover {
      color: var(--text-primary);
      background: color-mix(in srgb, var(--text-primary) 7%, transparent);
    }
    /* Touch: kein "klebender" Hover nach dem Tippen */
    @media (hover: none) {
      .nav-link:hover,
      .head.colored .nav-link:hover {
        background: transparent;
      }
    }
    .nav-link[aria-current="true"] {
      color: var(--accent);
    }

    .nav-projects-trigger,
    .projects-panel {
      display: none !important;
    }
    .nav-projects-mobile {
      display: flex;
    }

    .nav-cta-item {
      margin: 1.25rem 0 0;
    }
    .head .nav-cta,
    .head:not(.colored) .nav-cta {
      justify-content: center;
      width: 100%;
      padding: 0.9rem 1rem;
      font-size: 1.05rem;
      background: var(--accent);
      color: #fff;
    }

    .logo {
      width: 35px;
      translate: 0 0;
      transition: 1s;
      margin: 5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .head,
    .nav-link,
    .nav-link::after,
    .projects-panel,
    nav.mobile-menu,
    .burger span {
      transition: none !important;
    }
  }

  /* ---------- Logo (Markenzeichen, aus der alten Nav übernommen) ---------- */
  .logo {
    width: 45px;
    translate: 0 5px;
    transition: 1s;
  }

  .name {
    letter-spacing: -1px;
    color: tomato;
    font-family: monospace;
    font-size: 24px;
    .logo {
      transform: translate(4px, 2px);
    }
    .dev {
      font-size: 16px;
      translate: 0 2px;
      color: #ffffff;
      filter: blur(0);
      font-family: monospace;
    }
    span {
      transition: 1s;
      font-size: 0;
      filter: blur(1px);
    }
    i {
      transition: 0.5s;
      font-style: normal;
    }
    i:nth-of-type(2) {
      translate: -3px 11px;
      scale: 1.4;
    }
  }
  .name:hover {
    color: tomato;
    font-size: 24px;
    span {
      transition: 1s;
      color: #ffffff;
      font-size: 16px;
      filter: blur(0);
    }
    .dash {
      font-size: 0;
    }
    .logo {
      transform: translateX(3px) translateY(2px);
    }
    .dev {
      translate: 0 2px;
      font-size: 24px;
      color: tomato;
    }
    i:nth-of-type(2) {
      translate: 0 0;
      rotate: 360deg;
      scale: 1;
    }
  }
  .colored {
    .name {
      letter-spacing: normal;
      color: tomato;
      i:nth-of-type(2) {
        translate: 0 0;
        scale: 1;
      }
      .dev {
        font-size: 24px;
        color: tomato;
      }
      span {
        color: #ababab;
        font-size: 16px;
        translate: -1px 3px;
        filter: blur(0);
      }
      .dash {
        font-size: 0;
      }
      img {
        scale: 0.8;
        translate: 2px 2px;
      }
    }
  }

  .colored .name:hover {
    .logo {
      transform: translateX(10px) translateY(3px);
      scale: 0.7;
    }
    .dev {
      color: #616161;
      font-size: 24px;
      translate: 3px -2px;
    }
    span {
      font-size: 0;
    }
    .dash {
      font-size: 20px;
    }
    i:nth-of-type(1) {
      transition: 0.5s;
      font-size: 32px;
      font-style: normal;
      translate: 0px -5px;
      scale: 1;
    }
    i:nth-of-type(2) {
      transition: 0.5s;
      font-style: normal;
      translate: -3px 10px;
      scale: 1.5;
    }
  }

  .dark-mode .name span,
  .dark-mode .name:hover span {
    color: var(--text-primary);
  }
</style>

<script>
  import { onSectionChange } from "../scripts/sectionSpy";

  const navbar = document.getElementById("navbar")!;
  const menuBtn = document.getElementById("mobile-menu-btn")!;
  const menu = document.getElementById("main-nav")!;
  const projectsItem = document.getElementById("nav-projects-item")!;
  const projectsBtn = document.getElementById("nav-projects")!;

  // ---------- Header-Zustand beim Scrollen ----------
  const updateColored = () =>
    navbar.classList.toggle("colored", window.scrollY > 10);
  window.addEventListener("scroll", updateColored, { passive: true });
  updateColored();

  // ---------- Aktive Sektion ----------
  const sectionLinks = navbar.querySelectorAll<HTMLElement>("[data-section]");
  onSectionChange((id) => {
    sectionLinks.forEach((el) => {
      if (el.dataset.section === id) el.setAttribute("aria-current", "true");
      else el.removeAttribute("aria-current");
    });
  });

  // ---------- Mobile-Menü ----------
  const setMenu = (open: boolean) => {
    menu.classList.toggle("open", open);
    navbar.classList.toggle("menu-open", open);
    document.body.style.overflow = open ? "hidden" : "";
    menuBtn.setAttribute("aria-expanded", String(open));
    menuBtn.setAttribute("aria-label", open ? "Menü schließen" : "Menü öffnen");
  };
  const menuIsOpen = () => menu.classList.contains("open");

  menuBtn.addEventListener("click", () => setMenu(!menuIsOpen()));
  menu.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => menuIsOpen() && setMenu(false)),
  );
  // Beim Wechsel auf Desktop-Breite nicht im gesperrten Zustand hängen bleiben
  matchMedia("(min-width: 900px)").addEventListener("change", (e) => {
    if (e.matches && menuIsOpen()) setMenu(false);
  });

  // ---------- Projekte-Panel ----------
  // Maus: öffnet bei Hover, schließt mit Verzögerung (verzeiht kurzes Verlassen).
  // Klick/Tastatur/Touch: Toggle. Esc, Klick außerhalb oder Fokus-Verlust schließen.
  let closeTimer: number | undefined;
  let pinned = false; // per Klick geöffnet → Hover-Verlassen schließt nicht

  const isOpen = () => projectsItem.hasAttribute("data-open");
  const openPanel = () => {
    clearTimeout(closeTimer);
    projectsItem.setAttribute("data-open", "");
    projectsBtn.setAttribute("aria-expanded", "true");
  };
  const closePanel = () => {
    clearTimeout(closeTimer);
    pinned = false;
    projectsItem.removeAttribute("data-open");
    projectsBtn.setAttribute("aria-expanded", "false");
  };

  projectsItem.addEventListener("pointerenter", (e) => {
    if (e.pointerType === "mouse") openPanel();
  });
  projectsItem.addEventListener("pointerleave", (e) => {
    if (e.pointerType !== "mouse" || pinned) return;
    closeTimer = window.setTimeout(closePanel, 250);
  });

  projectsBtn.addEventListener("click", () => {
    if (!isOpen()) {
      openPanel();
      pinned = true;
    } else if (!pinned) {
      // per Hover offen → Klick hält es offen statt es zu schließen
      pinned = true;
    } else {
      closePanel();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (isOpen()) {
      closePanel();
      projectsBtn.focus();
    } else if (menuIsOpen()) {
      setMenu(false);
      menuBtn.focus();
    }
  });

  document.addEventListener("click", (e) => {
    if (isOpen() && !projectsItem.contains(e.target as Node)) closePanel();
  });

  projectsItem.addEventListener("focusout", (e) => {
    if (!projectsItem.contains(e.relatedTarget as Node)) closePanel();
  });

  projectsItem
    .querySelectorAll(".projects-panel a")
    .forEach((a) => a.addEventListener("click", closePanel));
</script>
