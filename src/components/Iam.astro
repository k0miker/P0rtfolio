---
import homeBg from "../assets/images/home.webp";
import inkBg from "../assets/images/ink_2.webp";
---

<div
  class="bg-container"
  id="home-section"
  style={`background-image: url(${homeBg.src})`}
>
  <div class="console-container font-[Marker] font-extrabold text-4xl">
    <div class="text-backdrop" style={`background-image: url(${inkBg.src})`}>
    </div>
    <span id="text" class="offscreen"></span><div
      class="console-underscore text-[tomato] animate-ping"
      id="console"
    >
      &#95;
    </div>
    <div class="hero-sub">
      <p class="hero-claim">Websites für Handwerk &amp; Mittelstand – schnell, mobil, gut gefunden.</p>
      <div class="hero-cta">
        <a class="hero-btn hero-btn--primary" href="#contact">Projekt anfragen</a>
        <a class="hero-btn" href="#projects">Projekte ansehen</a>
      </div>
    </div>
  </div>
</div>
<style>
  .hidden {
    opacity: 0;
  }
  span {
    min-height: 40px;
  }

  /* Feste Zeile unter dem Tipp-Text: was angeboten wird + direkte Wege */
  .hero-sub {
    position: absolute;
    top: calc(50% + 110px);
    left: 1rem;
    right: 1rem;
    z-index: 3;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  .hero-claim {
    margin: 0;
    max-width: 34ch;
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 0.85rem + 0.45vw, 1.2rem);
    font-weight: 400;
    line-height: 1.5;
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.85);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .hero-btn {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 400;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.75);
    color: #fff;
    background: rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }
  .hero-btn:hover {
    transform: translateY(-2px);
    border-color: #fff;
    background: rgba(0, 0, 0, 0.45);
  }
  .hero-btn--primary {
    background: var(--accent);
    border-color: var(--accent);
  }
  .hero-btn--primary:hover {
    background: color-mix(in srgb, var(--accent) 85%, black);
    border-color: color-mix(in srgb, var(--accent) 85%, black);
  }
  .hero-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .bg-container {
    background-size: cover !important;
    background-repeat: no-repeat !important;
    background-attachment: fixed !important;
    background-position: center !important;
    min-height: 100vh;
  }

  /* iOS Safari unterstützt background-attachment: fixed nicht korrekt */
  @media (hover: none) and (pointer: coarse) {
    .bg-container {
      background-attachment: scroll !important;
    }
  }

  .console-container {
    color: white;
    box-shadow: inset 0px -2vh 5vw 10px #0000006f;
    /* skalierter .text-backdrop (95% × scale 1.1) ragt sonst über den Viewport
       und macht die Seite mobil horizontal scrollbar */
    overflow-x: clip;

    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;

    position: relative;
    z-index: 1;
    top: 0;
    left: 0;
    right: 0;
    bottom: -30px;
    margin: auto;
  }

  /* Text-Styling mit starkem Schatten für bessere Lesbarkeit */
  #text {
    /* font-family: var(--font-mono); */
    text-shadow:
      0px 0px 10px rgba(0, 0, 0, 0.9),
      0px 0px 20px rgba(0, 0, 0, 0.7),
      0px 0px 30px rgba(0, 0, 0, 0.5);
    position: relative;
    z-index: 3;
  }

  /* Tintenhintergrund für den Text */
  .text-backdrop {
    position: absolute;
    width: 100%;
    max-width: 600px;
    height: 300px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.55;
    filter: contrast(1.2) brightness(0.6);
    transform: scale(1.2);
    z-index: 2;
    pointer-events: none;
  }

  .console-underscore {
    display: inline-block;
    position: relative;
    top: 0;
    left: 10px;
    z-index: 3;
    text-shadow: 0 0 10px rgba(255, 99, 71, 0.7); /* Glow-Effekt für den Cursor */
  }

  /* Responsive Anpassungen für verschiedene Bildschirmgrößen */
  @media screen and (max-width: 768px) {
    .console-container {
      font-size: 1.5em;
    }

    .text-backdrop {
      max-width: 90%;
      height: 350px;
      transform: scale(1.1);
    }

    #text {
      text-shadow:
        0px 0px 8px rgba(0, 0, 0, 0.607),
        1px 1px 6px rgba(0, 0, 0, 0.2);
    }
  }

  @media screen and (max-width: 480px) {
    .text-backdrop {
      max-width: 95%;
      height: 420px;
    }
  }
</style>
<script>
  // function([string1, string2],target id,[color1,color2])
  consoleText(
    [
      "Moin.",
      "Ich bin Colin.",
      "Webentwickler.",
      "Aus Fürstenau.",
      "Schnelle Websites.",
      "Gut gefunden.",
    ],
    "text",
    ["tomato"],
  );
  function consoleText(words, id, colors) {
    if (colors === undefined) colors = ["#fff"];
    let visible = true;
    let con = document.getElementById("console");
    let letterCount = 1;
    let x = 1;
    let waiting = false;
    let target = document.getElementById(id);
    target.setAttribute("style", "color:" + colors[0]);
    window.setInterval(function () {
      if (letterCount === 0 && waiting === false) {
        waiting = true;
        target.innerHTML = words[0].substring(0, letterCount);
        window.setTimeout(function () {
          let usedColor = colors.shift();
          colors.push(usedColor);
          let usedWord = words.shift();
          words.push(usedWord);
          x = 1;
          target.setAttribute("style", "color:" + colors[0]);
          letterCount += x;
          waiting = false;
        }, 300);
      } else if (letterCount === words[0].length + 1 && waiting === false) {
        waiting = true;
        window.setTimeout(function () {
          x = -1;
          letterCount += x;
          waiting = false;
        }, 500);
      } else if (waiting === false) {
        target.innerHTML = words[0].substring(0, letterCount);
        letterCount += x;
      }
    }, 80);
  }
</script>
