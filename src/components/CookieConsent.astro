---
// CookieConsent.astro - DSGVO-konformes Cookie-Banner mit Fokus auf deutsche Anforderungen
---

<!-- Cookie-Overlay, das die Seite blockiert -->
<div id="cookie-overlay" class="cookie-overlay">
  <div class="overlay-message">
    <i class="fa-solid fa-cookie-bite fa-2x"></i>
    <h2>Bitte Cookie-Einstellungen wählen</h2>
    <p>
      Um fortzufahren, treffen Sie bitte eine Auswahl bezüglich der
      Cookie-Einstellungen.
    </p>
  </div>
</div>

<div
  id="cookie-consent"
  class="cookie-banner"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cookie-title"
>
  <div class="cookie-content">
    <!-- Einfache Ansicht (Standard) -->
    <div id="simple-view" class="cookie-view active">
      <div class="cookie-header">
        <h3 id="cookie-title">Datenschutzeinstellungen</h3>
      </div>

      <p>
        Mit Ihrer Einwilligung nutze ich <strong>Google Analytics 4</strong>
        (Google Ireland Ltd.), um zu sehen, wie diese Website genutzt wird.
        Dabei werden Cookies gesetzt und Nutzungsdaten an Google übermittelt –
        auch eine Verarbeitung in den USA ist möglich. Ohne Einwilligung wird
        nichts davon geladen. Sie können Ihre Entscheidung jederzeit über
        „Cookie-Einstellungen“ im Footer ändern. Mehr in der
        <a href="/datenschutz">Datenschutzerklärung</a>.
      </p>

      <div class="cookie-actions">
        <button id="only-essential-cookies" class="btn-choice">Nur notwendige</button>
        <button id="accept-all-cookies" class="btn-choice">Alle akzeptieren</button>
      </div>
      <button id="show-settings" class="btn-link">Einstellungen</button>
    </div>

    <!-- Erweiterte Ansicht -->
    <div id="advanced-view" class="cookie-view">
      <div class="cookie-header">
        <h3>Einstellungen anpassen</h3>
        <button id="back-to-simple" aria-label="Zurück">
          <i class="fa-solid fa-arrow-left"></i>
        </button>
      </div>

      <div class="consent-options">
        <div class="option">
          <input type="checkbox" id="essential-cookies" checked disabled />
          <label for="essential-cookies"
            >Notwendig <span>(immer aktiv)</span></label
          >
          <div class="option-description">
            Speichert nur Ihre Auswahl sowie Theme- und Performance-Einstellung
            lokal in Ihrem Browser. Keine Cookies, keine Übermittlung.
          </div>
        </div>

        <div class="option">
          <input type="checkbox" id="analytics-cookies" />
          <label for="analytics-cookies"
            >Statistik <span>(Google Analytics 4)</span></label
          >
          <div class="option-description">
            Seitenaufrufe, Klicks, Geräte-/Browserdaten und ungefährer Standort.
            Cookies <code>_ga</code> und <code>_ga_*</code>, Laufzeit 28 Tage.
            Anbieter: Google Ireland Ltd.; Übermittlung in die USA möglich
            (EU-US Data Privacy Framework).
          </div>
        </div>
      </div>

      <div class="cookie-actions">
        <button id="reject-all-cookies" class="btn-choice">Nur notwendige</button>
        <button id="save-cookie-settings" class="btn-choice">Auswahl speichern</button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Cookie-Overlay-Styles */
  .cookie-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(5px);
    z-index: 9990; /* Niedriger als das Cookie-Banner */
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .cookie-overlay.visible {
    opacity: 1;
    pointer-events: all;
  }

  .overlay-message {
    background-color: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 2rem;
    text-align: center;
    max-width: 500px;
    margin: 0 1rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
  }

  .overlay-message i {
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .overlay-message h2 {
    font-family: "mono", monospace;
    color: var(--text-primary);
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .overlay-message p {
    color: var(--text-primary);
    font-family: "Inter", sans-serif;
    line-height: 1.5;
  }

  /* Cookie-Banner-Styles */
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: var(--bg-primary);
    box-shadow: 0 -5px 15px rgba(0, 0, 0, 0.1);
    z-index: 9999; /* Höher als das Overlay */
    padding: 1rem;
    border-top: 1px solid var(--border);
    transform: translateY(100%);
    transition: transform 0.4s ease-in-out;
    font-family: "Inter", sans-serif;
  }

  .cookie-banner.visible {
    transform: translateY(0);
  }

  .cookie-content {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
  }

  .cookie-view {
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    padding: 1rem;
  }

  .cookie-view.active {
    display: block;
    opacity: 1;
  }

  .cookie-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .cookie-header h3 {
    color: var(--text-primary);
    margin: 0;
    font-size: 1.3rem;
  }

  #cookie-close,
  #back-to-simple {
    background: none;
    border: none;
    color: var(--text-primary);
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0.3rem;
    transition: color 0.3s ease;
  }

  #cookie-close:hover,
  #back-to_simple:hover {
    color: var(--accent);
  }

  .cookie-banner p {
    margin-bottom: 1.2rem;
    line-height: 1.5;
    color: var(--text-primary);
  }

  .cookie-banner a {
    color: var(--accent);
    text-decoration: underline;
  }

  .consent-options {
    margin-bottom: 1.5rem;
  }

  .option {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 0.8rem;
  }

  .option input {
    margin-right: 0.8rem;
    accent-color: var(--accent);
    width: 1.2rem;
    height: 1.2rem;
  }

  .option label {
    font-weight: 500;
    color: var(--text-primary);
  }

  .option label span {
    font-weight: normal;
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-left: 0.3rem;
  }

  .option-description {
    padding-left: 2rem;
    width: 100%;
    margin-top: 0.3rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .cookie-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }

  /* Ablehnen und Zustimmen gleichwertig – kein Nudging */
  .cookie-actions > * {
    flex: 1 1 0;
  }

  .btn-choice {
    background-color: var(--bg-card);
    color: var(--text-primary);
    border: 1.5px solid var(--accent);
    border-radius: 6px;
    padding: 0.7rem 1.2rem;
    cursor: pointer;
    font-weight: 600;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  /* Hover nur mit Maus – auf Touch bliebe sonst ein Button "hervorgehoben" stehen */
  @media (hover: hover) {
    .btn-choice:hover {
      background-color: var(--accent);
      color: #fff;
    }
  }
  .btn-choice:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .btn-link {
    display: block;
    margin: 0.9rem auto 0;
    background: none;
    border: none;
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    font-size: 0.9rem;
  }

  .btn-link:hover {
    color: var(--accent);
  }

  .option-description code {
    font-size: 1em;
  }

  @media (max-width: 768px) {
    /* Cookie-Overlay auf mobilen Geräten anpassen */
    .cookie-overlay {
      background-color: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(10px);
      z-index: 9998;
    }

    .overlay-message {
      display: none; /* Verstecke die Overlay-Nachricht auf mobilen Geräten */
    }

    /* Cookie-Banner auf mobilen Geräten als zentriertes Modal darstellen */
    .cookie-banner {
      position: fixed;
      top: 50%;
      left: 50%;
      right: auto;
      bottom: auto;
      transform: translate(-50%, -50%);
      width: 95%;
      max-width: 420px;
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow:
        0 20px 50px rgba(0, 0, 0, 0.5),
        0 10px 20px rgba(0, 0, 0, 0.3);
      background-color: var(--bg-primary);
      z-index: 9999;
      max-height: 85vh;
      overflow-y: auto;
      border: 1px solid var(--border);
      /* Entferne die Standard-Transform-Animation für mobile */
      transition:
        opacity 0.3s ease,
        transform 0.3s ease;
    }

    /* Initialer Zustand für mobile Animation */
    .cookie-banner:not(.visible) {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.9);
      pointer-events: none;
    }

    /* Bei sichtbarem Banner */
    .cookie-banner.visible {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1) !important;
      pointer-events: all;
    }

    .cookie-content {
      padding: 0.5rem;
      max-width: 100%;
    }

    .cookie-view {
      padding: 0.5rem 0;
    }

    .cookie-header {
      margin-bottom: 1.5rem;
    }

    .cookie-header h3 {
      font-size: 1.2rem;
      line-height: 1.3;
    }

    /* Buttons untereinander und full-width für bessere Bedienbarkeit auf Touch-Geräten */
    .cookie-actions {
      flex-direction: column;
      gap: 0.8rem;
      margin-top: 1.5rem;
    }

    .btn-choice {
      width: 100%;
      padding: 0.9rem 1.2rem;
      font-size: 0.95rem;
      border-radius: 8px;
    }

    /* Consent Options auf mobile anpassen */
    .consent-options {
      margin: 1rem 0;
    }

    .option {
      margin-bottom: 1rem;
      padding: 1rem;
      background-color: color-mix(in srgb, var(--text-primary) 6%, transparent);
      border-radius: 8px;
    }

    .option-description {
      margin-top: 0.5rem;
      font-size: 0.85rem;
    }

    /* Touch-optimierte Checkbox-Größe */
    .option input[type="checkbox"] {
      width: 20px;
      height: 20px;
      margin-right: 1rem;
    }

    .option label {
      font-size: 0.95rem;
      line-height: 1.4;
    }
  }
</style>

<script>
  import { readConsent, saveConsent, loadAnalytics } from "../utils/consent.js";

  const banner = document.getElementById("cookie-consent")!;
  const overlay = document.getElementById("cookie-overlay")!;
  const simpleView = document.getElementById("simple-view")!;
  const advancedView = document.getElementById("advanced-view")!;
  const analyticsCheckbox = document.getElementById("analytics-cookies") as HTMLInputElement;
  const isMobile = () => window.matchMedia("(max-width: 768px)").matches;

  const showView = (advanced: boolean) => {
    simpleView.classList.toggle("active", !advanced);
    advancedView.classList.toggle("active", advanced);
  };

  const show = () => {
    banner.classList.add("visible");
    if (!isMobile()) overlay.classList.add("visible");
  };

  const decide = (analytics: boolean) => {
    saveConsent(analytics);
    banner.classList.remove("visible");
    overlay.classList.remove("visible");
    if (analytics) loadAnalytics();
  };

  document.getElementById("show-settings")!.addEventListener("click", () => {
    analyticsCheckbox.checked = Boolean(readConsent()?.analytics);
    showView(true);
  });
  document.getElementById("back-to-simple")!.addEventListener("click", () => showView(false));

  document.getElementById("accept-all-cookies")!.addEventListener("click", () => decide(true));
  document.getElementById("only-essential-cookies")!.addEventListener("click", () => decide(false));
  document.getElementById("reject-all-cookies")!.addEventListener("click", () => decide(false));
  document
    .getElementById("save-cookie-settings")!
    .addEventListener("click", () => decide(analyticsCheckbox.checked));

  const consent = readConsent();
  if (!consent) {
    // kurze Verzögerung, damit die Seite zuerst sichtbar ist
    setTimeout(show, 800);
  } else if (consent.analytics) {
    loadAnalytics();
  }
</script>
