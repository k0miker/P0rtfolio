---
// Die anderen Gestaltungen dieses Portfolios – getrennt von den Kundenprojekten
// (wie in v5). Ohne die aktuelle Seite (isCurrent aus projectData.js).
// Desktop: Ziehharmonika – die Version unter Maus/Fokus klappt auf.
// Touch & schmal: kompakte Liste.
import { projects } from "../data/projectData.js";

// Kurzlabels wie im Versionstoggle
const LABELS = { v1: "Classic", v2: "Story", v3: "Motion", terminal: "Codespace", v5: "Modernist", b2b: "Seriös" };

const versions = projects
  .filter((p) => p.category === "Portfolio" && !p.isCurrent)
  .map((p) => ({ ...p, label: LABELS[p.key] ?? "" }));
---

{versions.length > 0 && (
  <section id="versions" class="versions-section" aria-labelledby="versions-title">
    <div class="terminal-window offscreen">
      <div class="terminal-titlebar">
        <div class="terminal-dots" aria-hidden="true">
          <span class="dot-red"></span>
          <span class="dot-yellow"></span>
          <span class="dot-green"></span>
        </div>
        <span class="terminal-title">versions — colin@webdev</span>
      </div>

      <div class="terminal-body">
        <p class="terminal-cmd">
          <span class="usr">colin@webdev</span><span class="punct">:</span><span
            class="pth">~/portfolio</span
          ><span class="punct">$</span> ls versions/
        </p>

        <h2 id="versions-title">Weitere Versionen dieses Portfolios</h2>
        <p class="intro">
          Dieses Portfolio gibt es in mehreren Gestaltungen – dieselben Inhalte,
          jeweils ein anderer Ansatz.
        </p>

        <ul class="v-acc">
          {versions.map((v) => (
            <li class="v-panel">
              <a class="v-item" href={v.website}>
                <img class="v-img" src={v.image} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
                <span class="v-tab" aria-hidden="true">{v.title.replace("Portfolio ", "")}</span>
                <span class="v-text">
                  <span class="v-name">{v.title}</span>
                  {v.label && <span class="v-label">{v.label}</span>}
                  <span class="v-copy">{v.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
)}

<style>
  .versions-section {
    padding: 2rem 0 2rem;
  }

  h2 {
    font-family: var(--font-mono);
    font-size: var(--step-2, 1.6rem);
    color: var(--text-primary);
    margin: 0.5rem 0 0.5rem;
  }

  .intro {
    font-family: "Inter", sans-serif;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0 0 1.5rem;
    max-width: 60ch;
  }

  .v-acc {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .v-item {
    color: inherit;
    text-decoration: none;
  }

  .v-name {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-primary);
  }
  .v-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .v-label::before {
    content: "# ";
    color: var(--term-punct-color);
  }
  .v-copy {
    font-family: "Inter", sans-serif;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* ---------- Ziehharmonika (Desktop mit Maus) ---------- */
  @media (hover: hover) and (min-width: 721px) {
    .v-acc {
      display: flex;
      gap: 0.6rem;
      height: clamp(320px, 34vw, 420px);
    }

    .v-panel {
      flex: 1 1 0;
      min-width: 0;
      transition: flex-grow 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }
    /* Offen: unter Maus/Fokus – sonst die erste */
    .v-panel:hover,
    .v-panel:focus-within,
    .v-acc:not(:hover):not(:focus-within) .v-panel:first-child {
      flex-grow: 4.5;
    }

    .v-item {
      position: relative;
      display: block;
      height: 100%;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--term-window-border, var(--border));
      background: var(--bg-card);
    }
    .v-item:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }

    .v-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top left;
    }

    /* Verlauf unten, damit der Text auf jedem Bild lesbar bleibt */
    .v-item::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to top,
        rgba(15, 15, 15, 0.96) 0%,
        rgba(15, 15, 15, 0.86) 28%,
        rgba(15, 15, 15, 0.35) 52%,
        rgba(15, 15, 15, 0) 72%
      );
      transition: opacity 0.4s ease;
    }

    /* Zugeklappt: senkrechter Kurzname */
    .v-tab {
      position: absolute;
      left: 50%;
      bottom: 1rem;
      z-index: 1;
      transform: translateX(-50%) rotate(180deg);
      writing-mode: vertical-rl;
      font-family: var(--font-mono);
      font-weight: 600;
      font-size: 0.95rem;
      letter-spacing: 0.06em;
      color: #f5f5f5;
      white-space: nowrap;
      transition: opacity 0.3s ease;
    }

    .v-text {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 1.25rem 1.4rem;
      min-width: 300px;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9), 0 0 12px rgba(0, 0, 0, 0.6);
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity 0.3s ease,
        transform 0.3s ease;
      pointer-events: none;
    }
    .v-text .v-name {
      color: #f5f5f5;
      font-size: 1.1rem;
    }
    .v-text .v-copy {
      color: #d6d6d6;
      max-width: 46ch;
    }

    /* Aufgeklappt: Text ein, Kurzname aus */
    .v-panel:hover .v-text,
    .v-panel:focus-within .v-text,
    .v-acc:not(:hover):not(:focus-within) .v-panel:first-child .v-text {
      opacity: 1;
      transform: none;
      transition-delay: 0.15s;
    }
    .v-panel:hover .v-tab,
    .v-panel:focus-within .v-tab,
    .v-acc:not(:hover):not(:focus-within) .v-panel:first-child .v-tab {
      opacity: 0;
    }
    .v-panel:hover .v-item,
    .v-panel:focus-within .v-item {
      border-color: var(--accent);
    }
  }

  @media (hover: hover) and (min-width: 721px) and (prefers-reduced-motion: reduce) {
    .v-panel,
    .v-text,
    .v-tab {
      transition: none;
    }
  }

  /* ---------- Liste (Touch & schmal) ---------- */
  @media (hover: none), (max-width: 720px) {
    .v-tab {
      display: none;
    }
    .v-item {
      display: grid;
      grid-template-columns: 104px minmax(0, 1fr);
      column-gap: 1rem;
      align-items: start;
      padding: 1rem 0;
      border-top: 1px solid var(--term-window-border, var(--border));
    }
    .v-panel:last-child .v-item {
      border-bottom: 1px solid var(--term-window-border, var(--border));
    }
    .v-img {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      object-position: top center;
      border-radius: 6px;
    }
    .v-text {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .v-copy {
      font-size: 0.84rem;
    }
  }
</style>
