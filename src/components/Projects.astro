---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Modal from "./ui/Modal.astro";
import { projects } from "../data/projectData.js";
import "../css/keyframes.css";

// Showcase-Bühne: links ein großes Projekt (Desktop im Browser-Rahmen + Handy
// davor), rechts die Liste aller Projekte. Klick wechselt, sonst läuft die
// Bühne alle 6 s weiter. Bilder behalten ihr Format – nichts wird beschnitten.
// Nur Kundenprojekte – die Portfolio-Varianten stehen separat in OtherVersions.astro.
const filteredProjects = projects
  .filter((project) => !!project.image && project.category !== "Portfolio")
  .map((project) => {
    // Handy-Screenshot (z. B. /projects/p14-m.webp) nur, wenn die Datei existiert
    const mobile = project.image.replace(/\.webp$/, "-m.webp");
    return {
      ...project,
      category: project.category || "Other",
      mobile: existsSync(join(process.cwd(), "public", mobile)) ? mobile : null,
      host: project.website ? new URL(project.website).hostname.replace(/^www\./, "") : "",
    };
  });

// Extrahiere alle einzigartigen Kategorien
const categories = ["All", ...new Set(filteredProjects.map((project) => project.category))];

const pad = (n: number) => String(n).padStart(2, "0");
const total = pad(filteredProjects.length);
---

<section class="projects-wrapper min-h-full mt-9 relative">
  <h2
    class="text-center mt-4 p-8 text-4xl font-[mono] offscreen hover:tracking-[1vw] hover:text-[var(--accent)] text-[var(--text-primary)]"
  >
    Projekte<span class="animate-ping">_</span>
  </h2>

  <div class="terminal-window projects-terminal offscreen">
    <div class="terminal-titlebar">
      <div class="terminal-dots" aria-hidden="true">
        <span class="dot-red"></span>
        <span class="dot-yellow"></span>
        <span class="dot-green"></span>
      </div>
      <span class="terminal-title">projects — colin@webdev</span>
    </div>

    <div class="terminal-body">
      <p class="terminal-cmd">
        <span class="usr">colin@webdev</span><span class="punct">:</span><span class="pth">~/portfolio</span><span
          class="punct">$</span
        > ls projects/ <span class="cmd-filter" data-filter-cmd></span>
      </p>

      <!-- Filter Navigation -->
      <div class="filter-container">
        <div class="filter-buttons">
          {
            categories.map((category) => (
              <button class="filter-btn" data-category={category}>
                {category}
              </button>
            ))
          }
        </div>
      </div>

      <div class="showcase" data-showcase>
        <div class="showcase-left">
          <!-- Bühne: alle Projekte übereinander, nur das aktive ist sichtbar -->
          <div class="showcase-stack">
            {
              filteredProjects.map((project, i) => (
                <button
                  type="button"
                  class:list={["stage", !project.mobile && "stage--solo", i === 0 && "on"]}
                  data-modal-target={`modal-${project.id}`}
                  aria-label={`${project.title} – Details`}
                  tabindex={i === 0 ? 0 : -1}
                >
                  <span class="browser">
                    <span class="browser-bar" aria-hidden="true">
                      <i /><i /><i />
                      <span>{project.host}</span>
                    </span>
                    <span class="browser-shot">
                      <img
                        src={project.image}
                        alt={`Screenshot ${project.title}`}
                        width={1600}
                        height={1000}
                        loading={i === 0 ? "eager" : "lazy"}
                        decoding="async"
                      />
                    </span>
                  </span>
                  {project.mobile && (
                    <span class="phone">
                      <img src={project.mobile} alt="" width={780} height={1688} loading="lazy" decoding="async" />
                    </span>
                  )}
                </button>
              ))
            }
          </div>

          <div class="showcase-stack">
            {
              filteredProjects.map((project, i) => (
                <div class:list={["info", i === 0 && "on"]}>
                  <span class="info-meta">
                    {pad(i + 1)} / {total} · {project.category}
                  </span>
                  <h3 class="info-title">{project.title}</h3>
                  <p class="info-desc">{project.cardDescriptionEN || project.description}</p>
                  <ul class="info-tags">
                    {project.technologies?.map((tech: string) => <li>{tech}</li>)}
                  </ul>
                  <div class="info-actions">
                    <button type="button" class="info-link" data-modal-target={`modal-${project.id}`} tabindex={i === 0 ? 0 : -1}>
                      Details
                    </button>
                    {project.website && (
                      <a class="info-link" href={project.website} target="_blank" rel="noopener noreferrer" tabindex={i === 0 ? 0 : -1}>
                        Live ansehen ↗
                      </a>
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <ul class="showcase-list" aria-label="Projekte" data-total={`total ${filteredProjects.length}`}>
          {
            filteredProjects.map((project, i) => (
              <li data-category={project.category} class:list={[i === 0 && "on"]}>
                <button type="button" data-index={i} aria-current={i === 0 ? "true" : undefined}>
                  <span class="list-n">{pad(i + 1)}</span>
                  <span class="list-t">{project.title}</span>
                  <span class="list-c">{project.category}</span>
                  <i class="list-bar" aria-hidden="true" />
                </button>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="terminal-cmd terminal-cmd--last">
        <span class="usr">colin@webdev</span><span class="punct">:</span><span class="pth">~/portfolio</span><span
          class="punct">$</span
        > <span class="term-cursor" aria-hidden="true">▌</span>
      </p>
    </div>
  </div>

  {
    filteredProjects.map((project) => (
      <Modal project={project} image={project.image} />
    ))
  }
</section>

<style>
  .projects-wrapper {
    padding: 80px 0;
    transition: 1s;
    margin: auto 2vw;
    margin-left: auto;
    margin-right: auto;
    position: relative;
    overflow: hidden;
    min-height: 90vh; /* Garantiert ausreichende Höhe */
    @media screen and (max-width: 768px) {
      margin-top: 100px;
    }
  }

  /* Terminal-Fenster: Basis und Breite aus css/terminal.css (wie Versionen) */
  .cmd-filter {
    color: var(--term-path-color);
  }

  /* Filter Styles */
  .filter-container {
    display: flex;
    justify-content: flex-start;
    margin-bottom: 2rem;
    position: relative;
    z-index: 10;
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.5rem;
    position: relative;
    z-index: 11;
  }

  .filter-btn {
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background-color: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    cursor: pointer;
    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
    position: relative;
    z-index: 12;
    white-space: nowrap;
  }

  .filter-btn:hover {
    background-color: var(--accent);
    color: var(--bg-primary);
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
  }

  .filter-btn.active {
    background-color: var(--accent);
    color: var(--bg-primary);
    font-weight: bold;
  }

  /* ===== Showcase ===== */
  .showcase {
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    --frame: color-mix(in srgb, var(--text-primary) 10%, var(--bg-primary));
    --shot-shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 14px 36px -14px rgba(0, 0, 0, 0.3);
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  .showcase-left {
    display: grid;
    gap: 2rem;
    min-width: 0;
  }

  /* Alle Einträge im selben Grid-Feld: Höhe = größter Eintrag, kein Springen */
  .showcase-stack {
    display: grid;
  }
  .showcase-stack > * {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    translate: 0 12px;
    transition:
      opacity 0.5s,
      visibility 0s 0.5s,
      translate 0.6s var(--ease);
  }
  .showcase-stack > .on {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition:
      opacity 0.5s,
      visibility 0s,
      translate 0.6s var(--ease);
  }

  /* Bühne: Desktop im Browser-Rahmen, Handy davor */
  .stage {
    all: unset;
    box-sizing: border-box;
    display: block;
    position: relative;
    padding: 0 6% 8% 0;
    cursor: pointer;
  }
  .stage--solo {
    padding: 0;
  }
  .stage:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 12px;
  }

  .browser {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    background: var(--frame);
    box-shadow: var(--shot-shadow);
    transition: transform 0.5s var(--ease);
  }
  .browser-bar {
    height: 28px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 10px;
  }
  .browser-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--text-primary) 22%, transparent);
  }
  .browser-bar span {
    margin-left: 8px;
    font: 0.7rem var(--font-mono);
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .browser-shot {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: color-mix(in srgb, var(--text-primary) 6%, var(--bg-primary));
  }
  .browser-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.7s var(--ease);
  }

  .phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 21%;
    aspect-ratio: 780 / 1688;
    padding: 5px;
    border-radius: 22px;
    background: #1a1a1a;
    box-shadow: var(--shot-shadow);
    transition: transform 0.5s var(--ease);
  }
  .phone img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: 17px;
  }

  .stage:hover .browser-shot img {
    transform: scale(1.02);
  }
  .stage:hover .phone {
    transform: translateY(-10px) rotate(-2deg);
  }

  /* Text zum aktiven Projekt */
  .info-meta {
    font: 0.75rem var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.02em;
  }
  .info-title {
    margin: 0.4rem 0 0.75rem;
    font-size: clamp(1.5rem, 1.2rem + 1.3vw, 2.3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }
  .info-desc {
    margin: 0 0 1rem;
    max-width: 58ch;
    color: var(--text-secondary);
  }
  .info-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
  }
  .info-tags li {
    font: 0.72rem var(--font-mono);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 2px 9px;
  }
  .info-actions {
    display: flex;
    gap: 1.5rem;
  }
  .info-link {
    all: unset;
    cursor: pointer;
    font: 0.85rem var(--font-mono);
    color: var(--text-primary);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 1px;
    transition: color 0.2s;
  }
  .info-link:hover {
    color: var(--accent);
  }
  .info-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Projektliste als ls-Ausgabe */
  .showcase-list {
    position: sticky;
    top: 90px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .showcase-list::before {
    content: attr(data-total);
    display: block;
    padding: 0 2px 6px;
    font: 0.74rem var(--font-mono);
    color: var(--text-muted);
    border-bottom: 1px dashed var(--border);
  }
  .showcase-list li[hidden] {
    display: none;
  }
  .showcase-list button {
    all: unset;
    box-sizing: border-box;
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: 26px 1fr auto;
    gap: 10px;
    align-items: baseline;
    padding: 11px 2px 11px 18px;
    border-bottom: 1px dashed var(--border);
    cursor: pointer;
  }
  /* Zeiger vor dem aktiven Eintrag */
  .showcase-list button::before {
    content: "▸";
    position: absolute;
    left: 2px;
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .showcase-list .on button::before {
    opacity: 1;
  }
  .showcase-list button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .list-n {
    font: 0.74rem var(--font-mono);
    color: var(--text-muted);
  }
  .list-t {
    font-weight: 600;
    color: var(--text-primary);
    transition:
      color 0.2s,
      translate 0.3s var(--ease);
  }
  .list-c {
    font: 0.72rem var(--font-mono);
    color: var(--text-muted);
  }
  .showcase-list button:hover .list-t {
    translate: 6px 0;
  }
  .showcase-list .on .list-t,
  .showcase-list .on .list-n {
    color: var(--accent);
  }

  /* Fortschritt bis zum nächsten Projekt – das Ende der Animation schaltet weiter */
  .list-bar {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 0;
    height: 2px;
    background: var(--accent);
  }
  .showcase-list .on .list-bar {
    animation: showcase-fill 6s linear forwards;
  }
  .showcase:hover .list-bar,
  .showcase:has(:focus-visible) .list-bar,
  .showcase:not(.in-view) .list-bar {
    animation-play-state: paused;
  }
  @keyframes showcase-fill {
    to {
      width: 100%;
    }
  }

  /* Schmal: Bühne oben, Liste wird zur wischbaren Chip-Leiste darüber */
  @media (max-width: 860px) {
    .showcase {
      grid-template-columns: 1fr;
    }
    .showcase-list::before,
    .showcase-list button::before {
      display: none;
    }
    .showcase-list {
      order: -1;
      position: static;
      display: flex;
      gap: 8px;
      overflow-x: auto;
      border: 0;
      padding-bottom: 4px;
      scrollbar-width: none;
    }
    .showcase-list::-webkit-scrollbar {
      display: none;
    }
    .showcase-list li {
      flex: none;
    }
    .showcase-list button {
      grid-template-columns: auto;
      padding: 7px 14px;
      border: 1px solid var(--border);
      border-radius: 999px;
    }
    .list-n,
    .list-c,
    .list-bar {
      display: none;
    }
    .list-t {
      font-size: 0.88rem;
      font-weight: 500;
    }
    .showcase-list .on button {
      border-color: var(--accent);
    }
  }

  /* Ohne Bewegung: kein Autoplay, keine Übergänge */
  @media (prefers-reduced-motion: reduce) {
    .showcase-list .on .list-bar {
      animation: none;
    }
    .showcase-stack > *,
    .browser-shot img,
    .phone,
    .list-t {
      transition: none;
    }
  }

  @media screen and (max-width: 768px) {
    .filter-container {
      margin-bottom: 1.5rem;
      position: relative;
      padding: 0 0.5rem;
    }

    /* Verbesserte mobile Ansicht für Filter-Buttons */
    .filter-buttons {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding: 1rem 0.5rem;
      transform: rotateX(0);
      position: relative;
      gap: 0.75rem;
      -webkit-overflow-scrolling: touch; /* Für besseres Scrollen auf iOS */
      scrollbar-width: none; /* Firefox */
      mask-image: linear-gradient(to right, transparent, black 10px, black 90%, transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, black 10px, black 90%, transparent);
    }

    /* Verstecke Scrollbar bei Webkit-Browsern */
    .filter-buttons::-webkit-scrollbar {
      display: none;
    }

    .filter-btn {
      padding: 0.6rem 1.2rem;
      font-size: 0.9rem;
      min-width: auto;
      flex: 0 0 auto;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .filter-btn.active {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }
  }

  /* Noch kleinere Bildschirme */
  @media screen and (max-width: 480px) {
    .filter-btn {
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
    }

    .projects-wrapper {
      padding: 60px 0 40px;
    }

    .filter-buttons {
      justify-content: flex-start;
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    // --- Modal Logic ---
    let modalTriggers = document.querySelectorAll(".projects-wrapper [data-modal-target]");
    let openModal = null;

    modalTriggers.forEach(function (trigger) {
      trigger.addEventListener("click", function () {
        let modalId = trigger.getAttribute("data-modal-target");
        let modal = document.getElementById(modalId) as HTMLElement;

        if (openModal && openModal !== modal) {
          openModal.classList.remove("modal-open");
          setTimeout(() => {
            openModal.style.display = "none";
          }, 300);
        }

        if (modal) {
          modal.style.display = "flex";
          // Kleine Verzögerung für die Animation
          setTimeout(() => {
            modal.classList.add("modal-open");
          }, 10);
          openModal = modal;
        }
      });
    });

    let closeIcons = document.querySelectorAll(".modal .close");
    closeIcons.forEach(function (icon) {
      icon.addEventListener("click", function () {
        let modal = icon.closest(".modal") as HTMLElement;
        if (modal) {
          modal.classList.remove("modal-open");
          setTimeout(() => {
            modal.style.display = "none";
          }, 300);
          openModal = null;
        }
      });
    });

    window.addEventListener("click", function (event) {
      const targetElement = event.target as Element;
      if (targetElement.classList.contains("modal")) {
        const modal = targetElement as HTMLElement;
        modal.classList.remove("modal-open");
        setTimeout(() => {
          modal.style.display = "none";
        }, 300);
        openModal = null;
      }
    });

    // --- Showcase ---
    const showcase = document.querySelector("[data-showcase]") as HTMLElement | null;
    if (!showcase) return;

    const [stages, infos] = Array.from(showcase.querySelectorAll(".showcase-stack")).map(
      (stack) => Array.from(stack.children) as HTMLElement[],
    );
    const items = Array.from(showcase.querySelectorAll(".showcase-list li")) as HTMLElement[];
    const list = showcase.querySelector(".showcase-list") as HTMLElement;
    let current = 0;

    function show(index: number) {
      current = index;
      [stages, infos, items].forEach((set) =>
        set.forEach((el, i) => el.classList.toggle("on", i === index)),
      );
      // Nur das sichtbare Projekt ist per Tastatur erreichbar
      stages.forEach((el, i) => (el.tabIndex = i === index ? 0 : -1));
      infos.forEach((el, i) =>
        el.querySelectorAll<HTMLElement>("a, button").forEach((f) => (f.tabIndex = i === index ? 0 : -1)),
      );
      items.forEach((el, i) => {
        const btn = el.querySelector("button")!;
        if (i === index) btn.setAttribute("aria-current", "true");
        else btn.removeAttribute("aria-current");
      });
      // Fortschrittsbalken neu starten
      const bar = items[index].querySelector(".list-bar") as HTMLElement;
      bar.style.animation = "none";
      void bar.offsetWidth;
      bar.style.animation = "";
      // Chip-Leiste (mobil) zum aktiven Projekt scrollen, ohne die Seite zu bewegen
      const btn = items[index].querySelector("button")!;
      if (list.scrollWidth > list.clientWidth) {
        list.scrollTo({ left: btn.offsetLeft - list.clientWidth / 2 + btn.offsetWidth / 2, behavior: "smooth" });
      }
    }

    const visible = () => items.map((el, i) => (el.hidden ? -1 : i)).filter((i) => i >= 0);

    list.addEventListener("click", (event) => {
      const btn = (event.target as Element).closest("button");
      if (btn) show(Number(btn.dataset.index));
    });

    // Ende des Fortschrittsbalkens = nächstes sichtbares Projekt
    list.addEventListener("animationend", () => {
      const vis = visible();
      if (vis.length < 2) return;
      show(vis[(vis.indexOf(current) + 1) % vis.length]);
    });

    // Autoplay nur, solange die Bühne im Blick ist
    new IntersectionObserver(([entry]) => showcase.classList.toggle("in-view", entry.isIntersecting), {
      threshold: 0.3,
    }).observe(showcase);

    // --- Filter Logic ---
    const filterBtns = document.querySelectorAll(".filter-btn");
    const filterCmd = document.querySelector("[data-filter-cmd]");

    function handleFilterClick(event) {
      const btn = event.currentTarget;

      // Aktiven Button markieren
      filterBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");

      const category = btn.getAttribute("data-category");
      items.forEach((el) => (el.hidden = category !== "All" && el.dataset.category !== category));
      if (filterCmd) {
        filterCmd.textContent =
          category === "All" ? "" : `--category=${category.toLowerCase().replace(/\s+/g, "-")}`;
      }
      if (list.dataset.total) list.dataset.total = `total ${visible().length}`;

      const vis = visible();
      if (vis.length && !vis.includes(current)) show(vis[0]);

      // Zum geklickten Filter scrollen
      setTimeout(scrollToActiveFilter, 200);
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", handleFilterClick);
    });

    // Horizontales Scrollen der Filter-Buttons zum aktiven Element
    function scrollToActiveFilter() {
      const activeFilter = document.querySelector(".filter-btn.active");
      if (activeFilter) {
        const container = document.querySelector(".filter-buttons") as HTMLElement;
        if (container) {
          // Scroll zum aktiven Filter mit etwas Abstand links
          const scrollPos = (activeFilter as HTMLElement).offsetLeft - container.offsetWidth / 4;
          container.scrollTo({
            left: scrollPos,
            behavior: "smooth",
          });
        }
      }
    }

    // Initial den 'All' Button aktivieren
    const allButton = document.querySelector('.filter-btn[data-category="All"]');
    if (allButton) {
      allButton.classList.add("active");
    }

    // Initial Scroll zum aktiven Filter
    setTimeout(scrollToActiveFilter, 800);
  });
</script>
