---
// Seitenleiste links: Fortschrittslinie + klickbare Sektionspunkte.
// Sektionen kommen aus navSections – dieselbe Quelle wie die Nav.
import { navSections } from "../../data/navSections.js";
---

<nav class="section-rail" aria-label="Seitenabschnitte">
  <div class="rail-track" aria-hidden="true"><div class="rail-fill"></div></div>
  <ol>
    {
      navSections.map((s) => (
        <li>
          <a href={s.href} data-section={s.id}>
            <span class="rail-dot" aria-hidden="true" />
            <span class="rail-label">/{s.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .section-rail {
    --dot: 10px;
    position: fixed;
    left: 22px;
    top: 50%;
    z-index: 40;
    translate: 0 -50%;
    display: none;
  }

  /* Nur dort, wo links genug Rand ist – sonst übernimmt die Linie unter dem Header */
  @media (min-width: 1100px) {
    .section-rail {
      display: block;
    }
  }

  ol {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    list-style: none;
  }

  /* Linie läuft mittig durch die Punkte */
  .rail-track {
    position: absolute;
    top: calc(var(--dot) / 2);
    bottom: calc(var(--dot) / 2);
    left: calc(var(--dot) / 2 - 1px);
    width: 2px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--text-muted) 35%, transparent);
    overflow: hidden;
  }
  .rail-fill {
    height: 100%;
    background: var(--accent);
    transform: scaleY(var(--scroll-progress, 0));
    transform-origin: top;
  }

  a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    /* größere Trefferfläche, ohne das Layout zu verschieben */
    padding: 0.35rem 0.5rem 0.35rem 0;
    margin: -0.35rem 0;
    color: var(--text-muted);
    text-decoration: none;
  }

  .rail-dot {
    position: relative;
    flex: none;
    width: var(--dot);
    height: var(--dot);
    border: 2px solid currentColor;
    border-radius: 50%;
    background: var(--bg-primary);
    transition:
      transform 0.25s ease,
      background-color 0.25s ease,
      border-color 0.25s ease;
  }

  .rail-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    translate: -6px 0;
    transition:
      opacity 0.2s ease,
      translate 0.2s ease,
      color 0.2s ease;
  }

  /* Aktive Sektion: gefüllter Punkt + Label dauerhaft sichtbar */
  a[aria-current="true"] {
    color: var(--accent);
  }
  a[aria-current="true"] .rail-dot {
    background: var(--accent);
    transform: scale(1.3);
  }
  a[aria-current="true"] .rail-label {
    opacity: 0.9;
    translate: 0 0;
  }

  /* Hover über die Leiste zeigt alle Labels */
  .section-rail:hover .rail-label,
  .section-rail:focus-within .rail-label {
    opacity: 1;
    translate: 0 0;
  }
  a:hover,
  a:focus-visible {
    color: var(--text-primary);
  }
  a:hover .rail-dot {
    transform: scale(1.3);
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-dot,
    .rail-label {
      transition: none;
    }
  }
</style>

<script>
  import { onSectionChange } from "../../scripts/sectionSpy";

  const links = document.querySelectorAll<HTMLElement>(".section-rail [data-section]");
  onSectionChange((id) => {
    links.forEach((el) => {
      if (el.dataset.section === id) el.setAttribute("aria-current", "true");
      else el.removeAttribute("aria-current");
    });
  });
</script>
