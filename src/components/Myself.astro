---
import myself from "../assets/images/Cartoonify.svg";
import myself3 from "../assets/images/myself.webp";
---

<div class="wrap sm:flex-col rounded-lg offscreen relative">
  <h2
    class="py-5 font-[mono] text-4xl text-center offscreen hover:tracking-[.51vw] hover:text-[tomato] text-[var(--text-primary)]"
  >
    Über mich<span class="animate-ping">_</span>
  </h2>
  <div class="flex flex-col items-center offscreen">
    <div class="foto-swich">
      <img
        src={myself.src}
        class="sm:w-[100%] opacity-100"
        alt="Colin Blome"
      />
      <img src={myself3.src} class="sm:w-[100%]" alt="Colin Blome" />
    </div>

    <div class="content-section">
      <div class="terminal-window">
        <div class="terminal-titlebar">
          <div class="terminal-dots" aria-hidden="true">
            <span class="dot-red"></span>
            <span class="dot-yellow"></span>
            <span class="dot-green"></span>
          </div>
          <span class="terminal-title">about.md — colin@webdev</span>
          <div class="lang-buttons">
            <button type="button" class="lang-btn active" data-lang="de">DE</button>
            <button type="button" class="lang-btn" data-lang="en">EN</button>
          </div>
        </div>

        <div class="terminal-body">
          <p class="terminal-cmd">
            <span class="usr">colin@webdev</span><span class="punct">:</span><span
              class="pth">~</span
            ><span class="punct">$</span> cat about.md
          </p>

          <div class="language-content active" id="content-de">
            <p>
              Moin! Ich bin Colin, Webentwickler aus Fürstenau. Ich baue
              Websites für Handwerksbetriebe, Gastronomie und mittelständische
              Unternehmen – schnell, auf dem Handy genauso gut wie am Rechner
              und so aufgebaut, dass Ihre Kunden Sie bei Google finden.
            </p>
            <p>
              Bei mir haben Sie einen festen Ansprechpartner, von der ersten
              Idee bis zur laufenden Betreuung: kein Agentur-Overhead, kurze
              Wege und auf Wunsch ein Termin bei Ihnen vor Ort. Technisch setze
              ich auf schlanke, moderne Werkzeuge wie Astro – das macht Ihre
              Seite schnell und wartungsarm.
            </p>
            <p>
              Privat bin ich PC-Nerd, Gamer und pflege meine Bonsais. Geduld und
              Liebe zum Detail bringe ich also mit.
            </p>
          </div>

          <div class="language-content" id="content-en">
            <p>
              Hi! I'm Colin, a web developer from Fürstenau, Germany. I build
              websites for trades, restaurants and small to mid-sized
              businesses – fast, just as good on a phone as on a desktop, and
              built so your customers find you on Google.
            </p>
            <p>
              You get one personal point of contact, from the first idea to
              ongoing support: no agency overhead, short lines of communication
              and, if you like, a meeting on site. Technically I rely on lean,
              modern tools like Astro, which keeps your site fast and easy to
              maintain.
            </p>
            <p>
              In my spare time I'm a PC nerd, a gamer and I look after my bonsai
              trees – so patience and attention to detail come naturally.
            </p>
          </div>

          <p class="terminal-cmd terminal-cmd--last">
            <span class="usr">colin@webdev</span><span class="punct">:</span><span
              class="pth">~</span
            ><span class="punct">$</span> <span class="term-cursor">_</span>
          </p>
        </div>
      </div>

      <div class="terminal-window">
        <div class="terminal-titlebar">
          <div class="terminal-dots" aria-hidden="true">
            <span class="dot-red"></span>
            <span class="dot-yellow"></span>
            <span class="dot-green"></span>
          </div>
          <span class="terminal-title">whoami — colin@webdev</span>
        </div>

        <div class="terminal-body">
          <p class="terminal-cmd">
            <span class="usr">colin@webdev</span><span class="punct">:</span><span
              class="pth">~</span
            ><span class="punct">$</span> whoami --tags
          </p>

          <ul class="term-tags">
            <li>
              <span class="term-arrow">&gt;</span>
              <i class="fa-solid fa-keyboard"></i>
              <span>Webentwicklung</span>
            </li>
            <li>
              <span class="term-arrow">&gt;</span>
              <i class="fa-solid fa-user"></i>
              <span>UI/UX mit Liebe zum Detail</span>
            </li>
            <li>
              <span class="term-arrow">&gt;</span>
              <i class="fa-solid fa-leaf"></i>
              <span>Bonsai-Fan</span>
            </li>
          </ul>

          <p class="terminal-cmd terminal-cmd--last">
            <span class="usr">colin@webdev</span><span class="punct">:</span><span
              class="pth">~</span
            ><span class="punct">$</span> <span class="term-cursor">_</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const langBtns = document.querySelectorAll(".lang-btn");
    const langContents = document.querySelectorAll(".language-content");

    langBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const lang = btn.getAttribute("data-lang");

        // Update active button
        langBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        // Update active content
        langContents.forEach((content) => {
          content.classList.remove("active");
          if (content.id === `content-${lang}`) {
            content.classList.add("active");
          }
        });
      });
    });
  });
</script>

<style>
  .wrap {
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    padding-top: 40px;
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    height: fit-content;
  }

  img {
    width: 30%;
    max-width: 250px;
    opacity: 0.8;
    outline: 1px solid var(--border);
    object-fit: cover;
    border-radius: 15px;
    aspect-ratio: 1;
    transition: outline-color 0.3s ease;
  }

  h2 {
    font-family: mono;
    text-shadow: 2px 2px 3px rgba(255, 255, 255, 0);
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--text-titel);
  }

  p {
    font-family: "Inter", sans-serif;
    color: var(--text-primary);
    transition: 0.5s;
    line-height: 1.6;
    text-align: left;
  }

  .content-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 0 5vw;
    margin-top: 2rem;
  }

  .content-box {
    width: 90%;
    max-width: 1200px;
    background-color: var(--form-bg);
    border-radius: 12px;
    border: 1px solid var(--border);
    overflow: hidden;
    position: relative;
    margin-bottom: 2rem;
  }

  .language-switcher {
    display: flex;
    justify-content: flex-end;
    padding: 0.5rem;
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
  }

  .lang-btn {
    background: none;
    border: 1px solid transparent;
    padding: 0.25rem 0.75rem;
    margin-left: 0.5rem;
    border-radius: 4px;
    cursor: pointer;
    font-family: mono;
    font-size: 0.8rem;
    color: var(--text-titel);
    transition: all 0.3s ease;
  }

  .lang-btn:hover {
    color: tomato;
  }

  .lang-btn.active {
    border-color: var(--border);
    color: tomato;
    background-color: var(--bg-card);
  }

  .language-content {
    display: none;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.5s ease;
  }

  .language-content.active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== Terminal-Fenster (Bio) ===== */
  /* Basis-Chrome (.terminal-window/-titlebar/-dots/-title/-body/-cmd/-cursor)
     liegt jetzt global in css/terminal.css. Hier nur About-Spezifisches. */

  /* EN/DE als Terminal-Tabs auf der dunklen Leiste */
  .terminal-titlebar .lang-buttons {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  .terminal-titlebar .lang-btn {
    background: var(--term-input-bg);
    border: 1px solid var(--term-input-border);
    color: var(--term-cmd-color);
    padding: 0.15rem 0.6rem;
    margin: 0;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .terminal-titlebar .lang-btn:hover {
    color: var(--accent);
    border-color: rgba(255, 99, 71, 0.5);
  }
  .terminal-titlebar .lang-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* Bio-Output: lesbar, aber im Terminal-Kontext */
  .terminal-body .language-content p {
    /* Fließtext in Inter statt Mono: deutlich angenehmer zu lesen */
    font-family: var(--font-body);
    color: var(--term-text);
    line-height: 1.7;
    margin: 0 0 0.9rem;
    text-align: left;
    padding: 0;
  }

  /* whoami --tags Liste */
  .term-tags {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .term-tags li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--term-text);
    width: fit-content;
    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }
  .term-tags li:hover {
    color: var(--accent);
    transform: translateX(5px);
  }
  .term-tags .term-arrow {
    color: var(--accent);
  }
  .term-tags i {
    width: 1.4em;
    text-align: center;
    color: var(--term-path-color);
    transition: color 0.25s ease;
  }
  .term-tags li:hover i {
    color: var(--accent);
  }

  .content-header {
    background-color: var(--bg-secondary);
    padding: 1rem;
    text-align: center;
    font-size: 1.5rem;
    border-bottom: 1px solid var(--border);
    transition: all 0.3s ease;
  }
  .content-header2 {
    background-color: var(--bg-secondary);
    padding: .5rem;
    text-align: center;
    font-size: 1.5rem;
    transition: all 0.3s ease;
    width: 70%;
  }
  .content-header:hover,
  .content-header2:hover {
    letter-spacing: 0.51vw;
    color: var(--accent);
  }

  .skills-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    padding: 1rem 1rem;
  }

  .skill-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1 0 30%;
    padding: 1rem;
    transition: all 0.3s ease;
    font-family: mono;
  }

  .skill-item i {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    padding: 1rem;
  }

  .skill-item:hover {
    color: tomato;
    transform: scale(1.1);
  }

  .foto-swich {
    display: flex;
    justify-content: center;
    width: 200px;
    border-radius: 0px;
    margin-bottom: 2rem;
  }

  .foto-swich img {
    width: 200px;
    transition: 0.5s;
  }

  .foto-swich:hover img:nth-of-type(2) {
    opacity: 1;
  }

  .foto-swich:hover img:nth-of-type(1) {
    opacity: 0;
  }

  .foto-swich img:nth-of-type(2) {
    transform: translateX(-50%);
    opacity: 0;
  }

  .foto-swich img:nth-of-type(1) {
    transform: translateX(50%);
  }

  @media (min-width: 1280px) {
    .wrap {
      min-height: unset;
      padding-bottom: 60px;
    }
    .content-box {
      max-width: 1600px;
      width: 90%;
    }
  }

  @media (max-width: 768px) {
    .skill-item i {
      font-size: 2rem;
      padding: 0.5rem;
    }

    .content-box {
      width: 95%;
    }

    p {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .skills-container {
      flex-direction: column;
    }

    .skill-item {
      margin-bottom: 1rem;
    }

    .content-header {
      font-size: 1.25rem;
    }

    .lang-btn {
      padding: 0.15rem 0.5rem;
    }
  }

  @keyframes ping {
    75%,
    100% {
      opacity: 0;
    }
  }

  .animate-ping {
    animation: ping 1s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
</style>
