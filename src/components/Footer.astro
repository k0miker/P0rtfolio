    <!-- Kontaktinformationen mit Klick-Anzeige -->
    <div class="contact-info footer-item">
      <div class="contact-button email-button">
        <i class="fas fa-envelope"></i>
        <!-- <div class="contact-reveal email-reveal">
          <span class="email-parts">
            <span class="e-part">info</span><span class="e-sep">@</span><span class="e-domain">cb-webdevelopment.de</span>
          </span>
          <button class="copy-btn" data-copy="info@cb-webdevelopment.de">
            <i class="fas fa-copy"></i>
          </button>
        </div> -->
      </div>
      <div class="contact-button phone-button">
        <i class="fas fa-phone"></i>
        <!-- <div class="contact-reveal phone-reveal">
          <span class="phone-number">
            <span>0173</span>&ndash;<span>609</span>&ndash;<span>83</span><span>20</span>
          </span>
          <button class="copy-btn" data-copy="01736098320">
            <i class="fas fa-copy"></i>
          </button>
        </div> -->
