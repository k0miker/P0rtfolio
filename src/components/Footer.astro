</footer>

<style>
  .footer {
    --footer-line: color-mix(in srgb, var(--accent) 65%, transparent);
    background-color: var(--footer-bg, var(--bg-primary));
    border-top: 1px solid var(--footer-line);
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    width: 100%;
    /* Normaler Seiten-Footer statt fester Leiste: nimmt beim Lesen keinen Platz weg */
    position: relative;
    z-index: 2;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.18);    
  }
  
  /* Footer immer im aufgeklappten Layout */
  .footer.expanded {
    position: relative;
    height: auto;
    padding: 0.75rem 1rem;
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.18);
    z-index: 10; /* Höherer z-index für bessere Sichtbarkeit */
  }
  
  /* Separates Timing für collapse - schneller */
  .footer.collapsing {
    transition: all 0.2s cubic-bezier(0.6, 0.04, 0.98, 0.335);
  }
  
  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    height: 100%;
    position: relative;
  }
  
  .footer-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30%;
    transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
  }
  
  /* Animation für Icons im expandierten Zustand */
  .footer.expanded .footer-content{
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    justify-content: flex-start;
    padding: 0.5rem 0;
   
  }

  /* Social Icons */
   .social-icons{
    margin-top: 10px;
   }
  .social-icons ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap:.25rem;
  }

  .footer ul li:hover a i {
    color: var(--text-titel);
    background-color: var(--bg-secondary);
    transform: translateY(-10px) translatex(4px) rotate(-5deg) skew(5deg);
    box-shadow: -4px 4px rgb(255, 99, 71);
  }
  
  i {
    padding: 0.5rem;
    border-radius: 5px;
    transition: all 0.3s ease;
    margin: 1px;
  }

  .social-icons ul li a:hover i {
    color: var(--accent);
  }

  /* Kontaktinformationen mit Klick-Anzeige */
  .contact-info {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: 0.8rem;
  }
  
  .contact-button {
    position: relative;
    display: flex;
    align-items: center;
    cursor: pointer;
    padding: 0.1rem;
    border-radius: 6px;
    transition: all 0.3s ease;
    background-color: transparent;
    border: 1px solid transparent;
  }
  
  .contact-button i {
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .contact-button:hover {
   color: var(--text-titel);
    background-color: var(--bg-secondary);
    transform: translateY(-10px) translatex(4px) rotate(-5deg) skew(5deg);
    box-shadow: -4px 4px rgb(255, 99, 71);
  }
  
  .contact-button:hover i {
    color: var(--accent);
    animation: pulse 1s infinite;
  }
  
  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); }
  }
  
  .contact-reveal {
    position: absolute;
    top: -40px;
    left: 50%;
    transform: translateX(-50%) scale(0.8);
    background-color: var(--bg-secondary);
    padding: 0.4rem 0.7rem;
    border-radius: 6px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid rgba(255, 99, 71, 0.2);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
  }
  
  .contact-button.active .contact-reveal {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) scale(1);
    top: -45px;
  }

  .contact-reveal::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 50%;
    transform: translateX(-50%);
    width: 10px;
    height: 10px;
    background-color: var(--bg-secondary);
    transform: translateX(-50%) rotate(45deg);
    border-right: 1px solid rgba(255, 99, 71, 0.2);
    border-bottom: 1px solid rgba(255, 99, 71, 0.2);
  }
  
  .email-parts, .phone-number {
    font-family: 'mono', monospace;
    letter-spacing: 0.5px;
  }
  
  .copy-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    font-size: 0.9rem;
    padding: 0.2rem;
    border-radius: 4px;
    transition: all 0.3s ease;
  }
  
  .copy-btn:hover {
    color: var(--accent);
  }
  
  .copy-btn.copied {
    color: #4CAF50;
  }
  
  /* Copyright */
  .copyright {
    font-size: 0.8rem;
    text-align: center;
    flex-grow: 1;
  }

  /* Rechtliches */
  .impressum-container {
    flex-direction: column;
    gap: 0.35rem;
  }

  .legal-links {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .impressum-link {
    appearance: none;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.3s ease;
    padding: 0 0.75rem;
    white-space: nowrap;
  }

  .impressum-link:hover {
    color: var(--accent);
  }

  .footer.expanded .impressum-container {
    width: 100%;
    max-width: 420px;
  }

  /* Adaptiver Scroll-Button */
  .scroll-button {
    display: flex;
    justify-content: center;
    z-index: 10;
    position: absolute;
    top: -40px;
    left: 50%;
    transform: translateX(-50%);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    
  }
 
  .footer.expanded .scroll-button {
    top: -40px;
    transform: translateX(-50%) scale(1.1);
  }

  .scroll-button a {
    color: var(--text-secondary);
    background-color: var(--footer-bg, var(--bg-primary));
    border: 1px solid var(--footer-line);
    border-bottom: 0;
    height: 20px;
    width: 75px;
    font-family: inter;
    font-size: 16px;
    font-weight: 600;
    border-radius: 0.5em 0.5em 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    transition: all .3s;
    flex-direction: column;
    padding: 20px 20px;
  }

  .scroll-button a div {
    padding: 5px;
  }

  .scroll-button a:hover {
    transform: translateY(-2px);
  }

  .scroll-button a:hover div {
    color: tomato;
  }

  #scroll-icon {
    display: none;
  }
  
  .scroll-button a:hover #scroll-text {
    display: none;
  }

  .scroll-button a:hover #scroll-icon {
    display: block;
  }

  @media (max-width: 768px) {
    .social-icons ul {
      gap: 0.1rem;
    }

    .social-icons ul li a i {
      font-size: 0.8rem;
      padding: 2px;
    }

    .copyright {
      font-size: 0.6rem;
      width: 25%;
    }

    .impressum-link {
      font-size: 0.7rem;
    }

    .scroll-button a {
      width: 55px;
      font-size: 12px;
    }
    
    .footer-content {
      justify-content: space-between;
      padding: 0 5px;
    }
    
    .footer-item {
      width: auto;
      min-width: unset;
    }
    
    .contact-info {
      display: none; /* Im Footer auf Mobilgeräten ausblenden */
    }
    
    .footer.expanded .contact-info {
      display: flex; /* Im expandierten Footer anzeigen */
    }
  }
  
  @media (max-width: 480px) {
    .social-icons ul {
      gap: 0.15rem;
    }
    
    .social-icons ul li a i {
      font-size: 0.7rem;
      padding: 1px;
    }
    
    .footer.expanded .footer-content {
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }
    
    .footer.expanded {
      /* Inhalt (Socials, Kontakt, Copyright, Impressum) ist höher als 120px –
         feste Höhe schneidet die unteren Zeilen ab */
      height: auto;
    }
  }
</style>

<script>
  // Seit dem Aus für Google Analytics: Reste früherer Besuche aufräumen
  // (gespeicherte Einwilligung und _ga-Cookies), damit wirklich nichts bleibt.
  try {
    localStorage.removeItem('cookie-consent');
  } catch {}
  const host = location.hostname;
  const domains = ['', host, `.${host}`, `.${host.split('.').slice(-2).join('.')}`];
  document.cookie
    .split(';')
    .map((c) => c.split('=')[0].trim())
    .filter((name) => /^_ga($|_)|^_gid$|^_gat/.test(name))
    .forEach((name) => {
      domains.forEach((d) => {
        document.cookie = `${name}=; Max-Age=0; path=/${d ? `; domain=${d}` : ''}`;
      });
    });

  document.addEventListener('DOMContentLoaded', () => {

    // Smooth Scroll für den Button
    const scrollButton = document.querySelector('#scroll-action');
    if (scrollButton) {
      scrollButton.addEventListener('click', function(e) {
        e.preventDefault();
        
        const targetId = this.getAttribute('href');
        const targetElement = document.querySelector(targetId);
        
        if (targetElement) {
          targetElement.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    }
    
    // Kontaktelemente mit Klick-Anzeige und direkter Aktion
    const contactButtons = document.querySelectorAll('.contact-button');
    contactButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        // Direkte Aktion beim Klick auf den Button
        if (this.classList.contains('email-button')) {
          window.location.href = 'mailto:info@cb-webdevelopment.de';
          return; // Früher zurückkehren, um das Popup nicht anzuzeigen
        } else if (this.classList.contains('phone-button')) {
          window.location.href = 'tel:+491736098320';
          return; // Früher zurückkehren, um das Popup nicht anzuzeigen
        }
        
        // Rest des Codes nur ausführen, wenn wir nicht auf den Button selbst geklickt haben
        // Andere offene Kontaktbuttons schließen
        contactButtons.forEach(otherButton => {
          if (otherButton !== button) {
            otherButton.classList.remove('active');
          }
        });
        
        // Toggle für aktiven Zustand
        this.classList.toggle('active');
      });
    });
    
    // Außerhalb klicken, um zu schließen
    document.addEventListener('click', function(e) {
      const target = e.target as HTMLElement;
      const isOutsideContact = !target.closest('.contact-button');
      if (isOutsideContact) {
        contactButtons.forEach(button => {
          button.classList.remove('active');
        });
      }
    });
    
    // Kopieren-Funktionalität
    const copyButtons = document.querySelectorAll('.copy-btn');
    copyButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        e.stopPropagation(); // Verhindern, dass der kontaktbutton-Click ausgelöst wird
        
        const textToCopy = this.getAttribute('data-copy');
        navigator.clipboard.writeText(textToCopy).then(() => {
          // Visuelle Bestätigung
          this.classList.add('copied');
          const originalIcon = this.innerHTML;
          this.innerHTML = '<i class="fas fa-check"></i>';
          
          setTimeout(() => {
            this.classList.remove('copied');
            this.innerHTML = originalIcon;
          }, 2000);
        });
      });
    });
    
    // E-Mail und Telefon Links öffnen bei Klick auf die Inhalte
    const emailParts = document.querySelector('.email-parts');
    if (emailParts) {
      emailParts.addEventListener('click', (e) => {
        e.stopPropagation();
        window.location.href = 'mailto:info@cb-webdevelopment.de';
      });
    }
    
    const phoneNumber = document.querySelector('.phone-number');
    if (phoneNumber) {
      phoneNumber.addEventListener('click', (e) => {
        e.stopPropagation();
        window.location.href = 'tel:+491736098320';
      });
    }
  });
</script>
